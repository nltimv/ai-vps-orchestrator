# --- required ---------------------------------------------------------------
# Encryption key(s) for stored media. Generate with:  docker compose run --rm backend aivo generate-key
# Keep a copy somewhere safe: without it, the gallery cannot be decrypted.
AIVO_MEDIA_KEKS=

# --- cloud provider ----------------------------------------------------------
# fake = simulated machines (no cost); digitalocean = real GPU Droplets
AIVO_PROVIDER=fake
AIVO_DO_TOKEN=
# Optional: token that can ONLY delete droplets, for the worker self-destruct watchdog
AIVO_DO_WATCHDOG_TOKEN=
AIVO_WORKER_IMAGE=ghcr.io/nltimv/aivo-worker:latest
# Operating-system image for GPU machines (must include the GPU driver). The defaults are DigitalOcean's GPU images.
# AIVO_DO_BASE_IMAGE=gpu-h100x1-base
# AIVO_DO_BASE_IMAGE_AMD=gpu-amd-base
# Debugging only: ids/fingerprints of your own DigitalOcean SSH keys to add to every machine
# (also allow your address in Settings -> debug_ssh_cidrs). See docs/operations-do.md.
# AIVO_DO_SSH_KEY_IDS=

# --- optional: model mirror (DigitalOcean Spaces, public model files only) ---
AIVO_SPACES_KEY=
AIVO_SPACES_SECRET=
AIVO_SPACES_REGION=
AIVO_SPACES_BUCKET=
# AIVO_SPACES_ENDPOINT=http://minio:9000   # when using the minio profile

# Hugging Face token (only for gated models such as FLUX.2 [dev] full precision)
AIVO_HF_TOKEN=

# --- optional: single sign-on (OpenID Connect) -----------------------------------
# Register a client at your identity provider with redirect URI:
#   http://localhost:5173/api/v1/auth/oidc/callback   (or <AIVO_PUBLIC_URL>/api/v1/auth/oidc/callback)
AIVO_OIDC_ISSUER=
AIVO_OIDC_CLIENT_ID=
AIVO_OIDC_CLIENT_SECRET=
AIVO_OIDC_NAME=SSO
# comma separated; all optional
AIVO_OIDC_ALLOWED_DOMAINS=
AIVO_OIDC_ALLOWED_GROUPS=
AIVO_OIDC_ADMIN_GROUPS=
# false = only invited people may join via SSO
AIVO_OIDC_AUTO_PROVISION=true
# false = SSO only (no email/password sign-in)
AIVO_PASSWORD_LOGIN=true
# public URL of the dashboard, if it's not what the browser's Host header says
AIVO_PUBLIC_URL=

# --- optional: create the first admin automatically ----------------------------
AIVO_ADMIN_EMAIL=
AIVO_ADMIN_PASSWORD=

# Fake provider speed (seconds)
AIVO_FAKE_BOOT_SECONDS=4
AIVO_FAKE_JOB_SECONDS=4
