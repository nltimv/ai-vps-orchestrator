# --- required ---------------------------------------------------------------
# Encryption key(s) for stored media. Generate with:  docker compose run --rm backend aivo generate-key
# Keep a copy somewhere safe: without it, the gallery cannot be decrypted.
AIVO_MEDIA_KEKS=

# --- GPUs: RunPod Serverless ------------------------------------------------------
# fake = a simulated RunPod inside the backend (no cost, no GPUs); runpod = real RunPod Serverless
AIVO_PROVIDER=fake
# API key with read/write access to Serverless (RunPod console -> Settings -> API keys)
AIVO_RUNPOD_API_KEY=
# Where RunPod workers deliver results: this server's public HTTPS address (needed with runpod)
AIVO_PUBLIC_URL=
# AIVO_WORKER_API_URL=https://aivo.example.com    # only if workers should use another address
# Where workers may run (ISO country codes), or exact data centers (overrides the countries)
# AIVO_RUNPOD_COUNTRIES=NL,BE,DE,FR,CZ,RO,SE,NO,IS,FI,PL,ES,IT,AT,DK,IE,PT
# AIVO_RUNPOD_DATA_CENTERS=EU-NL-1,EU-RO-1
# Optional network volume that keeps model files between workers (pins workers to its data center)
# AIVO_RUNPOD_NETWORK_VOLUME_ID=
# Only these GPU types (RunPod names), e.g. "NVIDIA L40S,NVIDIA RTX A5000"
# AIVO_RUNPOD_GPU_TYPES=
# RunPod runs the worker image of the same release as the backend (a source build: :latest).
# Set this only to pin another image.
# AIVO_WORKER_IMAGE=ghcr.io/nltimv/aivo-worker:0.2.57

# Hugging Face token (only for gated models such as FLUX.2 [dev] full precision)
AIVO_HF_TOKEN=

# --- optional: single sign-on (OpenID Connect) -----------------------------------
# Register a client at your identity provider with redirect URI:
#   http://localhost:5173/api/v1/auth/oidc/callback   (or <AIVO_PUBLIC_URL>/api/v1/auth/oidc/callback)
AIVO_OIDC_ISSUER=
AIVO_OIDC_CLIENT_ID=
AIVO_OIDC_CLIENT_SECRET=
AIVO_OIDC_NAME=SSO
# comma separated; all optional
AIVO_OIDC_ALLOWED_DOMAINS=
AIVO_OIDC_ALLOWED_GROUPS=
AIVO_OIDC_ADMIN_GROUPS=
# false = only invited people may join via SSO
AIVO_OIDC_AUTO_PROVISION=true
# false = SSO only (no email/password sign-in)
AIVO_PASSWORD_LOGIN=true
# --- optional: create the first admin automatically ----------------------------
AIVO_ADMIN_EMAIL=
AIVO_ADMIN_PASSWORD=

# Fake provider speed (seconds)
AIVO_FAKE_BOOT_SECONDS=4
AIVO_FAKE_JOB_SECONDS=4
