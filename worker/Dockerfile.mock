# CPU-only mock worker (placeholder outputs), the same RunPod Serverless worker without a GPU: for trying
# a RunPod endpoint cheaply (CPU endpoint) and for demos.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
ARG RUNPOD_SDK_VERSION=2.2.1
RUN pip install --no-cache-dir "runpod==${RUNPOD_SDK_VERSION}"
COPY packages/protocol /src/protocol
COPY worker /src/worker
RUN pip install --no-cache-dir /src/protocol /src/worker
ENV AIVO_ENGINE=mock
ARG AIVO_VERSION=dev
ENV AIVO_VERSION=$AIVO_VERSION
ENTRYPOINT ["aivo-worker"]
