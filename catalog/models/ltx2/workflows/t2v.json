{
  "_comment": "LTX-2.x text-to-video with generated audio (distilled checkpoint).",
  "1": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "$ckpt"}},
  "2": {"class_type": "LTXAVTextEncoderLoader", "inputs": {"text_encoder": "gemma_3_12B_it_fp8_scaled.safetensors", "ckpt_name": "$ckpt", "device": "default"}},
  "3": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["2", 0], "text": "$prompt"}},
  "4": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["2", 0], "text": "$negative"}},
  "5": {"class_type": "LTXVConditioning", "inputs": {"positive": ["3", 0], "negative": ["4", 0], "frame_rate": "$fps"}},
  "6": {"class_type": "EmptyLTXVLatentVideo", "inputs": {"width": "$width", "height": "$height", "length": "$frames", "batch_size": 1}},
  "7": {"class_type": "LTXVAudioVAELoader", "inputs": {"ckpt_name": "$ckpt"}},
  "8": {"class_type": "LTXVEmptyLatentAudio", "inputs": {"audio_vae": ["7", 0], "frames_number": "$frames", "frame_rate": "$fps", "batch_size": 1}},
  "9": {"class_type": "LTXVConcatAVLatent", "inputs": {"video_latent": ["6", 0], "audio_latent": ["8", 0]}},
  "10": {"class_type": "LTXVScheduler", "inputs": {"steps": "$steps", "max_shift": 2.05, "base_shift": 0.95, "stretch": true, "terminal": 0.1, "latent": ["9", 0]}},
  "11": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "euler"}},
  "12": {"class_type": "RandomNoise", "inputs": {"noise_seed": "$seed"}},
  "13": {"class_type": "CFGGuider", "inputs": {"model": ["1", 0], "positive": ["5", 0], "negative": ["5", 1], "cfg": 1.0}},
  "14": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["12", 0], "guider": ["13", 0], "sampler": ["11", 0], "sigmas": ["10", 0], "latent_image": ["9", 0]}},
  "15": {"class_type": "LTXVSeparateAVLatent", "inputs": {"av_latent": ["14", 0]}},
  "16": {"class_type": "VAEDecode", "inputs": {"samples": ["15", 0], "vae": ["1", 2]}},
  "17": {"class_type": "LTXVAudioVAEDecode", "inputs": {"samples": ["15", 1], "audio_vae": ["7", 0]}},
  "18": {"class_type": "CreateVideo", "inputs": {"images": ["16", 0], "audio": ["17", 0], "fps": "$fps"}},
  "19": {"class_type": "SaveVideo", "inputs": {"video": ["18", 0], "filename_prefix": "$prefix", "format": "mp4", "codec": "h264"}}
}
