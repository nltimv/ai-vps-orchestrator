{
  "_comment": "LTX-2 text-to-video with generated audio, the distilled two-stage pipeline of ComfyUI's official template (video_ltx2_t2v_distilled): 8 steps at half size, the spatial upscaler doubles the latent, then 3 refining steps at full size.",
  "1": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "$ckpt"}},
  "2": {"class_type": "LTXAVTextEncoderLoader", "inputs": {"text_encoder": "gemma_3_12B_it_fp8_scaled.safetensors", "ckpt_name": "$ckpt", "device": "default"}},
  "3": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["2", 0], "text": "$prompt"}},
  "4": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["2", 0], "text": "$negative"}},
  "5": {"class_type": "LTXVConditioning", "inputs": {"positive": ["3", 0], "negative": ["4", 0], "frame_rate": "$fps"}},
  "6": {"class_type": "EmptyImage", "inputs": {"width": "$width", "height": "$height", "batch_size": 1, "color": 0}},
  "7": {"class_type": "ImageScaleBy", "inputs": {"image": ["6", 0], "upscale_method": "nearest-exact", "scale_by": 0.5}},
  "8": {"class_type": "GetImageSize", "inputs": {"image": ["7", 0]}},
  "9": {"class_type": "EmptyLTXVLatentVideo", "inputs": {"width": ["8", 0], "height": ["8", 1], "length": "$frames", "batch_size": 1}},
  "10": {"class_type": "LTXVAudioVAELoader", "inputs": {"ckpt_name": "$ckpt"}},
  "11": {"class_type": "LTXVEmptyLatentAudio", "inputs": {"audio_vae": ["10", 0], "frames_number": "$frames", "frame_rate": "$fps", "batch_size": 1}},
  "12": {"class_type": "LTXVConcatAVLatent", "inputs": {"video_latent": ["9", 0], "audio_latent": ["11", 0]}},
  "13": {"class_type": "RandomNoise", "inputs": {"noise_seed": "$seed"}},
  "14": {"class_type": "CFGGuider", "inputs": {"model": ["1", 0], "positive": ["5", 0], "negative": ["5", 1], "cfg": 1.0}},
  "15": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "euler_ancestral"}},
  "16": {"class_type": "ManualSigmas", "inputs": {"sigmas": "1., 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"}},
  "17": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["13", 0], "guider": ["14", 0], "sampler": ["15", 0], "sigmas": ["16", 0], "latent_image": ["12", 0]}},
  "18": {"class_type": "LTXVSeparateAVLatent", "inputs": {"av_latent": ["17", 1]}},
  "19": {"class_type": "LatentUpscaleModelLoader", "inputs": {"model_name": "ltx-2-spatial-upscaler-x2-1.0.safetensors"}},
  "20": {"class_type": "LTXVLatentUpsampler", "inputs": {"samples": ["18", 0], "upscale_model": ["19", 0], "vae": ["1", 2]}},
  "21": {"class_type": "LTXVConcatAVLatent", "inputs": {"video_latent": ["20", 0], "audio_latent": ["18", 1]}},
  "22": {"class_type": "ManualSigmas", "inputs": {"sigmas": "0.909375, 0.725, 0.421875, 0.0"}},
  "23": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["13", 0], "guider": ["14", 0], "sampler": ["15", 0], "sigmas": ["22", 0], "latent_image": ["21", 0]}},
  "24": {"class_type": "LTXVSeparateAVLatent", "inputs": {"av_latent": ["23", 1]}},
  "25": {"class_type": "VAEDecodeTiled", "inputs": {"samples": ["24", 0], "vae": ["1", 2], "tile_size": 512, "overlap": 64, "temporal_size": 4096, "temporal_overlap": 8}},
  "26": {"class_type": "LTXVAudioVAEDecode", "inputs": {"samples": ["24", 1], "audio_vae": ["10", 0]}},
  "27": {"class_type": "CreateVideo", "inputs": {"images": ["25", 0], "audio": ["26", 0], "fps": "$fps"}},
  "28": {"class_type": "SaveVideo", "inputs": {"video": ["27", 0], "filename_prefix": "$prefix", "format": "mp4", "codec": "h264"}}
}
