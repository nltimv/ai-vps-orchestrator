{
  "_comment": "Wan 2.2 A14B text-to-video: high-noise expert for the first steps, low-noise expert for the rest.",
  "1": {"class_type": "UNETLoader", "inputs": {"unet_name": "$t2v_high", "weight_dtype": "default"}},
  "2": {"class_type": "UNETLoader", "inputs": {"unet_name": "$t2v_low", "weight_dtype": "default"}},
  "3": {"class_type": "LoraLoaderModelOnly", "inputs": {"model": ["1", 0], "lora_name": "wan2.2_t2v_lightx2v_4steps_lora_v1.1_high_noise.safetensors", "strength_model": "$lora_strength"}},
  "4": {"class_type": "LoraLoaderModelOnly", "inputs": {"model": ["2", 0], "lora_name": "wan2.2_t2v_lightx2v_4steps_lora_v1.1_low_noise.safetensors", "strength_model": "$lora_strength"}},
  "5": {"class_type": "ModelSamplingSD3", "inputs": {"model": ["3", 0], "shift": "$shift"}},
  "6": {"class_type": "ModelSamplingSD3", "inputs": {"model": ["4", 0], "shift": "$shift"}},
  "7": {"class_type": "CLIPLoader", "inputs": {"clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan", "device": "default"}},
  "8": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["7", 0], "text": "$prompt"}},
  "9": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["7", 0], "text": "$negative"}},
  "10": {"class_type": "VAELoader", "inputs": {"vae_name": "wan_2.1_vae.safetensors"}},
  "11": {"class_type": "EmptyHunyuanLatentVideo", "inputs": {"width": "$width", "height": "$height", "length": "$frames", "batch_size": 1}},
  "12": {"class_type": "KSamplerAdvanced", "inputs": {"model": ["5", 0], "add_noise": "enable", "noise_seed": "$seed",
         "steps": "$steps", "cfg": "$cfg", "sampler_name": "euler", "scheduler": "simple",
         "positive": ["8", 0], "negative": ["9", 0], "latent_image": ["11", 0],
         "start_at_step": 0, "end_at_step": "$split_step", "return_with_leftover_noise": "enable"}},
  "13": {"class_type": "KSamplerAdvanced", "inputs": {"model": ["6", 0], "add_noise": "disable", "noise_seed": "$seed",
         "steps": "$steps", "cfg": "$cfg", "sampler_name": "euler", "scheduler": "simple",
         "positive": ["8", 0], "negative": ["9", 0], "latent_image": ["12", 0],
         "start_at_step": "$split_step", "end_at_step": 10000, "return_with_leftover_noise": "disable"}},
  "14": {"class_type": "VAEDecode", "inputs": {"samples": ["13", 0], "vae": ["10", 0]}},
  "15": {"class_type": "CreateVideo", "inputs": {"images": ["31", 0], "fps": "$out_fps"}},
  "16": {"class_type": "SaveVideo", "inputs": {"video": ["15", 0], "filename_prefix": "$prefix", "format": "mp4", "codec": "h264"}},
  "30": {"class_type": "FrameInterpolationModelLoader", "inputs": {"model_name": "film_net_fp16.safetensors"}},
  "31": {"class_type": "FrameInterpolate", "inputs": {"interp_model": ["30", 0], "images": ["14", 0], "multiplier": "$interpolate"}}
}
